AIDA_SEED=42
AIDA_TARGET_CLASS=Car
AIDA_N_TRAIN=400
AIDA_N_VAL=120
AIDA_ERROR_RATIO=0.3
AIDA_EPOCHS=50
AIDA_BATCH_SIZE=16
AIDA_IMG_SIZE=640
AIDA_DEVICE=auto
# ↑ auto: cuda > mps > cpu 순 자동 감지 (M1 Mac·CUDA 데스크탑 등 어디서든 그대로 동작)
# 특정 디바이스를 강제하고 싶으면 cuda / mps / cpu 중 하나로 명시
AIDA_KITTI_LABEL_URL=https://s3.eu-central-1.amazonaws.com/avg-kitti/data_object_label_2.zip
AIDA_KITTI_IMAGE_URL=https://s3.eu-central-1.amazonaws.com/avg-kitti/data_object_image_2.zip

# 스모크 테스트 예시 (소규모 샘플 + 1 epoch)
